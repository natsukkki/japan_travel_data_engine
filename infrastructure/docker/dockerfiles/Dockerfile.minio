FROM golang:1.24-alpine AS build

RUN apk add --no-cache git ca-certificates

ENV CGO_ENABLED=0

RUN git clone --depth 1 --branch RELEASE.2025-09-07T16-13-09Z \
      https://github.com/minio/minio.git /src/minio \
    && test "$(git -C /src/minio rev-parse HEAD)" = \
      07c3a429bfed433e49018cb0f78a52145d4bedeb

WORKDIR /src/minio
RUN go build -tags kqueue -trimpath \
      -ldflags "$(go run buildscripts/gen-ldflags.go)" \
      -o /out/minio .

RUN git clone --depth 1 --branch RELEASE.2025-08-13T08-35-41Z \
      https://github.com/minio/mc.git /src/mc \
    && test "$(git -C /src/mc rev-parse HEAD)" = \
      7394ce0dd2a80935aded936b09fa12cbb3cb8096

WORKDIR /src/mc
RUN go build -tags kqueue -trimpath \
      -ldflags "$(go run buildscripts/gen-ldflags.go)" \
      -o /out/mc .

FROM alpine:3.21

RUN apk add --no-cache ca-certificates curl
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /out/mc /usr/local/bin/mc

EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
